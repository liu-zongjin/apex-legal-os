{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stella",
  "version": "0.1.0",
  "identifier": "com.stella.windows",
  "build": {"frontendDist": "../ui"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "main", "title": "Stella", "width": 840, "height": 660, "minWidth": 700, "minHeight": 560}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": [{"identifier": "installer", "windows": ["main"], "permissions": ["core:event:allow-listen", "core:event:allow-unlisten"]}]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/bootstrap-engine.exe"],
    "windows": {
      "webviewInstallMode": {"type": "embedBootstrapper", "silent": true},
      "nsis": {"installMode": "currentUser", "languages": ["SimpChinese"], "displayLanguageSelector": false}
    }
  }
}
