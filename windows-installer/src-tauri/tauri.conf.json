{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stella",
  "version": "1.1.8",
  "identifier": "com.stella.windows",
  "build": {"frontendDist": "../ui"},
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": [{"identifier": "installer", "windows": ["main"], "permissions": ["core:event:allow-listen", "core:event:allow-unlisten"]}, {"identifier": "local-workspace", "windows": ["main"], "remote": {"urls": ["http://127.0.0.1:18865/*"]}, "permissions": ["core:event:allow-listen", "core:event:allow-unlisten"]}]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis"],
    "resources": ["resources/bootstrap-engine.exe"],
    "windows": {
      "webviewInstallMode": {"type": "embedBootstrapper", "silent": true},
      "nsis": {"installMode": "currentUser", "languages": ["SimpChinese"], "displayLanguageSelector": false}
    }
  }
}
